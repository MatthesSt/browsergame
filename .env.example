# Hostname Traefik should route to this service.
DOMAIN=game.example.com

# The docker network your Traefik container is attached to (`docker network ls`).
TRAEFIK_NETWORK=traefik

# Names from your Traefik static config: the HTTPS entrypoint and the ACME
# resolver. `websecure` and `letsencrypt` are the common defaults.
ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt

# Only for `--profile tunnel`: the connector token of a named Cloudflare tunnel
# (Zero Trust > Networks > Tunnels). The `quick` profile needs nothing at all.
TUNNEL_TOKEN=
